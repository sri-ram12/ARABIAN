// Production PostgreSQL Prisma Schema for Arabian Mandi Platform
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  phone         String    @unique
  password      String
  role          String    @default("CUSTOMER") // CUSTOMER, ADMIN, KITCHEN_STAFF, DELIVERY_PARTNER
  profileImage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  addresses     Address[]
  orders        Order[]               @relation("CustomerOrders")
  deliveries    DeliveryAssignment[]  @relation("PartnerDeliveries")
  locations     DeliveryLocation[]
  reviews       Review[]
  supportTickets SupportTicket[]
  notifications Notification[]

  @@index([role])
  @@index([email])
  @@index([phone])
}

model Address {
  id                   String   @id @default(uuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressLine          String
  landmark             String?
  area                 String   
  city                 String   @default("Thagarapuvalasa")
  state                String   @default("Andhra Pradesh")
  pincode              String   @default("531162")
  latitude             Float
  longitude            Float
  addressType          String   @default("HOME")
  deliveryInstructions String?
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  orders               Order[]

  @@index([userId])
}

model Restaurant {
  id                   String   @id @default("arabian-mandi-main")
  name                 String   @default("Arabian Mandi")
  tagline              String   @default("Authentic Arabian Flavours Delivered Across Thagarapuvalasa")
  description          String   @default("Experience the royal taste of Yemen & Gulf traditions.")
  logo                 String?
  coverImage           String?
  address              String   @default("NH16 Highway Road, Near Sangivalasa Bridge, Thagarapuvalasa, Andhra Pradesh 531162")
  latitude             Float    @default(17.9288)
  longitude            Float    @default(83.4350)
  phone                String   @default("+91 89192 34567")
  email                String   @default("contact@arabianmandi.in")
  openingHours         String   @default("11:00 AM")
  closingHours         String   @default("11:30 PM")
  isOpen               Boolean  @default(true)
  deliveryRadiusKm     Float    @default(15.0)
  minOrderAmount       Float    @default(200.0)
  baseDeliveryFee      Float    @default(40.0)
  freeDeliveryThreshold Float   @default(599.0)
  taxPercentage        Float    @default(5.0)
  packagingFee         Float    @default(25.0)
  codEnabled           Boolean  @default(true)
  cancellationAllowedMinutes Int @default(5)
  estimatedPrepTimeMin Int      @default(25)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Category {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  image       String?
  displayOrder Int       @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       MenuItem[]

  @@index([slug])
}

model MenuItem {
  id                 String           @id @default(uuid())
  categoryId         String
  category           Category         @relation(fields: [categoryId], references: [id])
  name               String
  slug               String           @unique
  description        String
  image              String
  price              Float
  discountedPrice    Float?
  isVeg              Boolean          @default(false)
  isAvailable        Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  isBestseller       Boolean          @default(false)
  preparationTimeMin Int              @default(25)
  spiceLevel         String           @default("MEDIUM")
  servingSize        String           @default("SERVES_1_2")
  servesCount        Int              @default(2)
  ingredients        String?          
  sizesJson          String?          
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  addons             MenuItemAddon[]
  orderItems         OrderItem[]

  @@index([categoryId])
  @@index([isAvailable])
  @@index([isBestseller])
}

model MenuItemAddon {
  id          String    @id @default(uuid())
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name        String
  price       Float
  isAvailable Boolean   @default(true)

  @@index([menuItemId])
}

model Order {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique 
  customerId           String
  customer             User                @relation("CustomerOrders", fields: [customerId], references: [id])
  addressId            String
  address              Address             @relation(fields: [addressId], references: [id])
  status               String              @default("PLACED")
  
  subtotal             Float
  discount             Float               @default(0.0)
  deliveryFee          Float               @default(0.0)
  tax                  Float               @default(0.0)
  packagingFee         Float               @default(0.0)
  totalAmount          Float
  
  appliedCoupon        String?
  deliveryInstructions String?
  kitchenNotes         String?
  deliveryOtp          String              @default("1234")
  estimatedDeliveryMin Int                 @default(45)

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  items                OrderItem[]
  payment              Payment?
  deliveryAssignment   DeliveryAssignment?
  review               Review?
  supportTickets       SupportTicket[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  name        String
  size        String?
  price       Float
  quantity    Int
  addOnsJson  String?  
  subtotal    Float

  @@index([orderId])
}

model Payment {
  id                 String    @id @default(uuid())
  orderId            String    @unique
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod      String    
  status             String    @default("PENDING") 
  amount             Float
  currency           String    @default("INR")
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  refundId           String?
  refundAmount       Float?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([razorpayOrderId])
}

model DeliveryAssignment {
  id                   String    @id @default(uuid())
  orderId              String    @unique
  order                Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  deliveryPartnerId    String
  deliveryPartner      User      @relation("PartnerDeliveries", fields: [deliveryPartnerId], references: [id])
  status               String    @default("ASSIGNED")
  earnings             Float     @default(50.0)
  distanceKm           Float     @default(3.5)
  assignedAt           DateTime  @default(now())
  acceptedAt           DateTime?
  pickedUpAt           DateTime?
  deliveredAt          DateTime?
  notes                String?

  @@index([deliveryPartnerId])
  @@index([status])
}

model DeliveryLocation {
  id                String    @id @default(uuid())
  deliveryPartnerId String
  deliveryPartner   User      @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)
  orderId           String?
  latitude          Float
  longitude         Float
  heading           Float?
  speed             Float?
  timestamp         DateTime  @default(now())

  @@index([deliveryPartnerId])
  @@index([orderId])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  title          String
  description    String
  discountType   String    
  discountValue  Float
  minOrderAmount Float     @default(0.0)
  maxDiscount    Float?
  usageLimit     Int?
  timesUsed      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

model DeliveryZone {
  id                 String   @id @default(uuid())
  name               String   
  minDistanceKm      Float
  maxDistanceKm      Float
  deliveryFee        Float
  estimatedTimeMin   Int
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Review {
  id             String    @id @default(uuid())
  orderId        String    @unique
  order          Order     @relation(fields: [orderId], references: [id])
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  rating         Int       @default(5) 
  foodRating     Int       @default(5)
  deliveryRating Int       @default(5)
  comment        String
  isApproved     Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isApproved])
}

model SupportTicket {
  id          String    @id @default(uuid())
  ticketId    String    @unique 
  customerId  String
  customer    User      @relation(fields: [customerId], references: [id])
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id])
  issueType   String    
  subject     String
  message     String
  status      String    @default("OPEN") 
  priority    String    @default("MEDIUM") 
  adminNotes  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([status])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("INFO")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}
