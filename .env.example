# Arabian Mandi Environment Configuration Example
# DATABASE_URL="postgresql://postgres:password@localhost:5432/arabian_mandi?schema=public"
DATABASE_URL="file:./dev.db"

JWT_SECRET="your_secure_jwt_secret_key"
NEXTAUTH_SECRET="your_nextauth_secret_key"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway (Test or Live keys)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Google Maps API (Optional: interactive OpenStreetMap/Leaflet fallback is built-in)
GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# Restaurant Location
NEXT_PUBLIC_RESTAURANT_NAME="Arabian Mandi"
NEXT_PUBLIC_RESTAURANT_PHONE="+91 89192 34567"
NEXT_PUBLIC_RESTAURANT_LAT="17.9288"
NEXT_PUBLIC_RESTAURANT_LNG="83.4350"
NEXT_PUBLIC_RESTAURANT_CITY="Thagarapuvalasa"

# Cloud Storage
CLOUD_STORAGE_BUCKET=""
CLOUD_STORAGE_ACCESS_KEY=""
CLOUD_STORAGE_SECRET_KEY=""

# SMTP / Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
